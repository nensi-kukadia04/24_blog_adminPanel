<%- include('../layouts/header') %>


<div class="container my-4">
    <div class="d-flex justify-content-end align-items-center mb-4">
        <!-- Search Form -->
        <form class="d-flex">
            <input type="search" name="categorySearch" class="form-control me-2" placeholder="Search Categories" value="<%= search %>">
            <input type="submit" value="submit" class="btn btn-outline-primary"/>
        </form>
        <a href="/category/ViewCategory" class="ms-2 btn btn-outline-dark">reset</a>
    </div>
    <!-- Heading -->
    <h2 class="text-center mb-4">Existing Categories</h2>
    <!-- Categories Table -->
     <form method="post" action="/category/deleteMultipleCategory">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>
                        <input type="checkbox" id="checkAll">
                        <button id="deleteAll" class="btn btn-sm btn-primary bi bi-trash3"></button>
                    </th>
                    <th>#</th>
                    <th>Category Name</th>
                    <th>Category status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (view_category.length > 0) { %>
                    <% view_category.forEach(v => { %>
                        <tr>
                            <td>
                                <input type="checkbox" name="Ids" value="<%= v.id %>">
                            </td>
                            <td><%= ++no %></td>
                            <td><%= v.categoryName %></td>
                            <td>
                                <% if(v.status){ %>
                                    <a href="/category/changeStatus/?catId=<%= v.id %>&status=true" class="btn btn-sm btn-success">Active</a>
                                <% }else{ %>
                                    <a href="/category/changeStatusTrue/?catId=<%= v.id %>&status=false" class="btn btn-sm btn-danger">Deactive</a>
                                <% } %>
                            </td>
                            <td>
                                <a href="/category/deleteCategory/<%= v. id %>" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="2" class="text-center">No categories found.</td>
                    </tr>
                <% } %>
             <tr>
                    <td>
                        <a href="/category/viewCategory?page=<%=parseInt(page)-1%>&categorySearch=<%= search %>" class="btn btn-sm <%= page<1 ? 'disabled' : '' %>"  > Prev </a>
                        <a href="/category/viewCategory?page=<%=parseInt(page)%>" class="btn btn-sm"><%=parseInt(page)+1 %></a>
                        <a href="/category/viewCategory?page=<%=parseInt(page)+ 1%>&categorySearch=<%= search %>" class="btn btn-sm <%= totalCount<=parseInt(page)+ 1 ? 'disabled' : '' %>">Next</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
</div>

<%- include('../layouts/footer') %>
<script src="https://code.jquery.com/jquery-3.7.1.min.js" type="text/javascript"></script>
<script>
    $("#deleteAll").hide();
    $("#checkAll").click(function(){
        $('input:checkbox').not(this).prop('checked', this.checked);
        $("#deleteAll").toggle();
    });
</script>