<%- include('userHeader') %>
            <!-- Main Content -->
            <div class="col-md-9">
                <div class="content">
                    <% allBlog.map((v,i)=>{ %>
                        <div class="card mb-4">
                            <div class="row g-0">
                                <div class="col-md-1">
                                    <img src="<%= v.image %>" class="img-fluid rounded-start" alt="Blog Image">
                                </div>
                                <div class="col-md-11">
                                    <div class="card-body">
                                        <h5 class="card-title"><%= v.title %></h5>
                                        <p class="card-text"><%- v.description.substr(0,150) %>... </p> 
                                        <a href="/singlePage/<%= v.id %>" class="btn btn-danger">See More</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
        <!-- Pagination  -->

        <div class="d-flex align-items-center justify-content-around mb-5 mt-3">
            <a href="/?page=<%=parseInt(page)-1%>&blogSearch=<%= search %>"   class="btn btn-sm btn-primary <%= page<1 ? 'disabled' : '' %>">  Prev</a>
            <a href="/?page=<%=parseInt(page)%>"><button class="btn btn-sm btn-outline-primary"><%=parseInt(page)+1 %></button></a>
            <a href="/?page=<%=parseInt(page)+ 1%>&blogSearch=<%= search %>"  class="btn btn-sm btn-primary  <%= totalCounts<=parseInt(page)+ 1 ? 'disabled' : '' %>">Next</a>
        </div>
    </main>

